  "fixed_sql": [
    {
      "name": "trip_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"trip_records\" (\"id\" TEXT NOT NULL, \"started_at_ms\" INTEGER NOT NULL, \"ended_at_ms\" INTEGER NULL, \"distance_meters\" REAL NOT NULL DEFAULT 0.0, \"max_speed\" REAL NOT NULL DEFAULT 0.0, \"elapsed_us\" INTEGER NOT NULL DEFAULT 0, \"moving_us\" INTEGER NOT NULL DEFAULT 0, \"paused\" INTEGER NOT NULL DEFAULT 1 CHECK (\"paused\" IN (0, 1)), \"segment\" INTEGER NOT NULL DEFAULT 0, \"last_point_ms\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "trip_points",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"trip_points\" (\"trip_id\" TEXT NOT NULL REFERENCES trip_records (id) ON DELETE CASCADE, \"timestamp_ms\" INTEGER NOT NULL, \"speed\" REAL NOT NULL, \"segment\" INTEGER NOT NULL, \"over_limit\" INTEGER NOT NULL CHECK (\"over_limit\" IN (0, 1)), \"latitude\" REAL NULL, \"longitude\" REAL NULL, \"accuracy\" REAL NULL, \"altitude\" REAL NULL, \"heading\" REAL NULL, PRIMARY KEY (\"trip_id\", \"timestamp_ms\"));"
        }
      ]
    },
    {
      "name": "distance_days",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"distance_days\" (\"local_day\" TEXT NOT NULL, \"meters\" REAL NOT NULL, PRIMARY KEY (\"local_day\"));"
        }
      ]
    },
    {
      "name": "fuel_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"fuel_records\" (\"id\" TEXT NOT NULL, \"occurred_at_ms\" INTEGER NOT NULL, \"distance_meters\" REAL NOT NULL, \"fuel_liters\" REAL NOT NULL, \"fuel_cost\" REAL NOT NULL, \"other_cost\" REAL NOT NULL, \"currency_code\" TEXT NOT NULL, \"note\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"id\"));"
        }
      ]
    }
